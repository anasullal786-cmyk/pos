# Copy this file to backend/.env and fill in your values.

# ── Server ─────────────────────────────────────────────────────────────
PORT=5000

# ── Supabase ───────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API:
#   • SUPABASE_URL              → "Project URL"
#   • SUPABASE_SERVICE_ROLE_KEY → "service_role" secret (server-side only!)
#
# The service_role key bypasses Row Level Security — never expose it to
# the frontend or commit it to git. Create the tables first by running
# backend/supabase/schema.sql in the Dashboard → SQL Editor.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
